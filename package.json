{
  "name": "horizonte",
  "private": true,
  "type": "module",
  "description": "Horizonte \u00e2\u20ac\u201d recent Meteosat image sequences for Spain and the western Mediterranean.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "make:sample": "node scripts/make-sample.ts",
    "verify": "npm run build"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
